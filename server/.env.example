# AI concierge (optional — only needed for "Ask the guide")
ANTHROPIC_API_KEY=sk-ant-...
ALLOWED_ORIGIN=https://banksy1224.github.io
# PORT is provided by Railway automatically; defaults to 8787 locally.

# --- Campus-tour RFI (POST /api/rfi) ----------------------------------------
# SMTP: email the resolved campus admissions inbox. Host + From are enough
# to attempt a send (some relays are IP-auth); USER/PASS optional.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASS=

# Optional last-resort inbox (used for Shanghai when set, and as fallback).
DEFAULT_RFI_EMAIL=

# Optional CRM webhook. Destination interface: SMTP and/or this URL.
RFI_WEBHOOK_URL=
# auto | email | webhook | both
RFI_DESTINATION=auto

# Optional Postgres. When set, RFIs persist in rfi_inquiries (created on first
# write). Without it, inquiries stay in process memory so prospects never 500.
# This is the Keiser Globe table — there are no SEC Genie tables here.
DATABASE_URL=
# Set to 0 to disable SSL (local Postgres). Railway typically needs SSL.
# DATABASE_SSL=0
